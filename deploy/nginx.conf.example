# Отдельный server для учёта оборудования на FirstVDS.
# Кладёте рядом с конфигом текущего сайта, его не заменяете.
#
# 1. Поддомен equipment.example.ru → IP сервера
# 2. Скопировать в /etc/nginx/sites-available/equipment
# 3. ln -s /etc/nginx/sites-available/equipment /etc/nginx/sites-enabled/
# 4. certbot --nginx -d equipment.example.ru
# 5. nginx -t && systemctl reload nginx

server {
    listen 80;
    server_name equipment.example.ru;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Content-Security-Policy "frame-ancestors 'self' https://*.bitrix24.ru https://*.bitrix24.com https://*.bitrix24.by https://*.bitrix24.kz https://*.bitrix24.ua;" always;

    # Загрузка документов: запас над лимитом файла в 50 МБ.
    client_max_body_size 60m;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering off;
        proxy_connect_timeout 60s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;
    }
}
