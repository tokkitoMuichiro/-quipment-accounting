# Backend
DATABASE_URL=postgresql://equipment:equipment@localhost:5433/equipment
JWT_SECRET=change-me-to-a-long-random-string
PORT=3010
FRONTEND_URL=http://localhost:5173

# Local development without Bitrix (set false in production)
DEV_AUTH=true

# Optional: Bitrix user IDs that become admins on first login
ADMIN_BITRIX_IDS=

# Bitrix24 local application
BITRIX_CLIENT_ID=
BITRIX_CLIENT_SECRET=
BITRIX_EXCEL_FILENAME=Учёт оборудования (авто).xlsx

# Excel auto-export delay (ms)
EXCEL_DEBOUNCE_MS=60000
