# Backend
DATABASE_URL=postgresql://equipment:equipment@localhost:5433/equipment
JWT_SECRET=change-me-to-a-long-random-string
PORT=3010
FRONTEND_URL=http://localhost:5173

# Local login by full name. Must stay false on the server.
DEV_AUTH=true
# Create demo users/warehouse on seed (local only; ignored when NODE_ENV=production)
SEED_DEMO_USERS=true

# Bitrix user IDs that become admins on first login (comma-separated)
ADMIN_BITRIX_IDS=

# Bitrix24 local application — leave empty until the portal app exists
BITRIX_CLIENT_ID=
BITRIX_CLIENT_SECRET=
# Permanent application_token from Bitrix app settings (required in production)
BITRIX_APPLICATION_TOKEN=
# Optional separate key for encrypting portal tokens at rest (defaults to JWT_SECRET)
BITRIX_TOKEN_KEY=
BITRIX_EXCEL_FILENAME=Учёт оборудования (авто).xlsx
# For IM notifications also enable scope: im

# Excel auto-export delay (ms)
EXCEL_DEBOUNCE_MS=60000
